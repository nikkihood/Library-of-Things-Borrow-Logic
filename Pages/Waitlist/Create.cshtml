@page
@model LibraryOfThingsM4.Pages.Waitlist.CreateModel

@{
    ViewData["Title"] = "Add to Waitlist";
}

<h1>Add to Waitlist</h1>
<hr />
<div class="row">
    <div class="col-md-5">
        <form method="post">
            <div asp-validation-summary="ModelOnly" class="text-danger"></div>
            <div class="form-group mb-3">
                <label asp-for="Waitlist.ItemId" class="control-label">Item</label>
                <select asp-for="Waitlist.ItemId" asp-items="Model.ItemOptions" class="form-select">
                    <option value="0">-- Select an item --</option>
                </select>
                <span asp-validation-for="Waitlist.ItemId" class="text-danger"></span>
                @if (!Model.ItemOptions.Any())
                {
                    <small class="text-danger">No items are available to add to the waitlist.</small>
                }
            </div>
            <div class="form-group mb-3">
                <label asp-for="Waitlist.MemberId" class="control-label"></label>
                <input asp-for="Waitlist.MemberId" class="form-control" type="number" min="1" />
                <span asp-validation-for="Waitlist.MemberId" class="text-danger"></span>
            </div>
            <div class="form-group mb-3">
                <label asp-for="Waitlist.RequestDate" class="control-label"></label>
                <input asp-for="Waitlist.RequestDate" class="form-control" type="date" />
                <span asp-validation-for="Waitlist.RequestDate" class="text-danger"></span>
            </div>
            <div class="form-check mb-3">
                <input asp-for="Waitlist.Nortified" class="form-check-input" />
                <label asp-for="Waitlist.Nortified" class="form-check-label">Notified</label>
            </div>
            <div class="form-check mb-3">
                <input asp-for="Waitlist.Recieved" class="form-check-input" />
                <label asp-for="Waitlist.Recieved" class="form-check-label">Received</label>
            </div>
            <button type="submit" class="btn btn-primary">Create</button>
        </form>
    </div>
</div>

<p class="mt-3"><a asp-page="./Index">Back to List</a></p>

@section Scripts {
    @{ await Html.RenderPartialAsync("_ValidationScriptsPartial"); }
}
