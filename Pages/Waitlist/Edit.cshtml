@page
@model LibraryOfThingsM4.Pages.Waitlist.EditModel

@{
    ViewData["Title"] = "Edit Waitlist Entry";
}

<h1>Edit Waitlist Entry</h1>
<hr />
<div class="row">
    <div class="col-md-5">
        <form method="post">
            <div asp-validation-summary="ModelOnly" class="text-danger"></div>
            <input type="hidden" asp-for="Waitlist.ItemId" />
            <input type="hidden" asp-for="Waitlist.MemberId" />
            <div class="form-group mb-3">
                <label class="control-label">Item ID</label>
                <input class="form-control" value="@Model.Waitlist.ItemId" readonly />
            </div>
            <div class="form-group mb-3">
                <label class="control-label">Member ID</label>
                <input class="form-control" value="@Model.Waitlist.MemberId" readonly />
            </div>
            <div class="form-group mb-3">
                <label asp-for="Waitlist.RequestDate" class="control-label"></label>
                <input asp-for="Waitlist.RequestDate" class="form-control" type="date" />
                <span asp-validation-for="Waitlist.RequestDate" class="text-danger"></span>
            </div>
            <div class="form-check mb-3">
                <input asp-for="Waitlist.Nortified" class="form-check-input" />
                <label asp-for="Waitlist.Nortified" class="form-check-label">Notified</label>
            </div>
            <div class="form-check mb-3">
                <input asp-for="Waitlist.Recieved" class="form-check-input" />
                <label asp-for="Waitlist.Recieved" class="form-check-label">Received</label>
            </div>
            <button type="submit" class="btn btn-primary">Save</button>
        </form>
    </div>
</div>

<p class="mt-3"><a asp-page="./Index">Back to List</a></p>

@section Scripts {
    @{ await Html.RenderPartialAsync("_ValidationScriptsPartial"); }
}
